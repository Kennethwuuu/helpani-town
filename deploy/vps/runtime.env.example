# Unapplied example: copy privately to /etc/helpani-town/runtime.env only after
# the hostname, free local port, server paths, and isolated Node runtime are checked.
# The service uses /opt/helpani-town/runtime/bin/node (deployed VPS version: 22.22.0).
# The local historical pin remains 22.20.0; the VPS passed the same 33 targeted checks.
# Keep the real file root-owned with mode 0600, outside source and served files.
# Set application credentials through the authorized secure connection, never chat.
# Do not copy the local .env wholesale or add Render/cloud/Git management keys.

NODE_ENV=production
HOST=127.0.0.1
# Candidate port only; confirm it is free and match the reverse proxy upstream.
PORT=3120
# Replace this placeholder with the final HTTPS hostname; no path or trailing slash.
PUBLIC_ORIGIN=https://demo.example.org
# StateDirectory in the service owns this persistent location. Preserve WAL/SHM too.
DB_PATH=/var/lib/helpani-town/helpani.sqlite

ASTRO_GATEWAY_MODEL=claude-sonnet-4-6
# Lifetime attempt caps include failures and the permitted format retry.
# These persist in SQLite; they are not daily resets or a dollar spending limit.
# A global value of 0 disables the guard. Run only one app process/instance.
AI_DEMO_MAX_REQUESTS=100
AI_DEMO_SESSION_MAX_REQUESTS=10
AI_DEMO_MAX_CONCURRENT=1

# Existing permitted application settings only; keep PayPal credentials in Sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Astropods HTTPS gateway origin only; no /v1, query, or embedded credentials.
ASTRO_GATEWAY_URL=
ASTRO_GATEWAY_API_KEY=
