PORT=3000
HOST=localhost
PUBLIC_ORIGIN=http://localhost:3000
DB_PATH=data/helpani.sqlite

# Sandbox app credentials from the PayPal Developer Dashboard.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Astropods AI Gateway host only (HTTPS, no /v1 path); never use the CLI OAuth token here.
# Obtain an account Gateway key for this standalone Node service; see docs/astropods-setup.md.
# A gateway-enabled agent project can alternatively inject these values into its runtime.
ASTRO_GATEWAY_URL=
ASTRO_GATEWAY_API_KEY=
# ASTRO_GATEWAY_MODEL=claude-sonnet-4-6
# MODEL_DEFAULT from an Astropods runtime is also supported when ASTRO_GATEWAY_MODEL is unset.

# Hosted demo: count every Gateway attempt, including the one allowed format retry.
# 0 disables these limits locally. Render sets 100 total attempts, 10 per session, concurrency 1.
# Counts persist in SQLite and do not reset with time or service restarts.
AI_DEMO_MAX_REQUESTS=0
# AI_DEMO_SESSION_MAX_REQUESTS=10
# AI_DEMO_MAX_CONCURRENT=1
